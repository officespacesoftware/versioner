{
  "name": "@officespacesoftware/versioner",
  "version": "1.0.1",
  "description": "Version-numbering tasks that create the appropriate Git objects",
  "main": "lib/index.js",
  "type": "module",
  "bin": {
    "versioner": "bin/versioner"
  },
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "dev:test": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "prepublishOnly": "npm test",
    "build": "echo 'No build step required - pure JS'",
    "prepack": "echo 'Preparing package for publishing...'"
  },
  "devDependencies": {
    "jest": "^30.0.0",
    "@jest/globals": "^30.0.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "files": [
    "lib/**/*.js",
    "bin/versioner",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "version",
    "versioning",
    "git",
    "semantic-version",
    "release",
    "semver",
    "cli",
    "release-candidate",
    "git-tags"
  ],
  "author": "Esteban Trejos",
  "license": "MIT",
  "homepage": "https://github.com/officespacesoftware/versioner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/officespacesoftware/versioner.git"
  },
  "bugs": {
    "url": "https://github.com/officespacesoftware/versioner/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
