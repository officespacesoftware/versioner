    {
      "type": "rich_text",
      "elements": [
        {
          "type": "rich_text_section",
          "elements": [
            {
              "type": "text",
              "text": "How approval works",
              "style": {
                "bold": true
              }
            }
          ]
        },
        {
          "type": "rich_text_list",
          "style": "bullet",
          "indent": 0,
          "elements": [
            {
              "type": "rich_text_section",
              "elements": [
                {
                  "type": "text",
                  "text": "Anything that changes origin posts a plan first, listing every change. A release approver applies it, or cancels it."
                }
              ]
            },
            {
              "type": "rich_text_section",
              "elements": [
                {
                  "type": "text",
                  "text": "A plan with no warnings and no deletions has Approve, with a one-line confirmation. A plan with a ⚠️ warning or a deletion has Review & approve instead: the full plan opens, and approving happens there."
                }
              ]
            },
            {
              "type": "rich_text_section",
              "elements": [
                {
                  "type": "text",
                  "text": "Approve applies exactly the plan shown. If the repository moved in between, nothing is applied and the new plan is posted for review."
                }
              ]
            },
            {
              "type": "rich_text_section",
              "elements": [
                {
                  "type": "text",
                  "text": "A downmerge into develop that conflicts is resolved by the agent in a pull request; into main it stops for a human decision."
                }
              ]
            }
          ]
        }
      ]
    },
